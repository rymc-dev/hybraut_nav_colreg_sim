<?xml version="1.0"?>
<!-- Controllable cargo tanker traffic vessel. See sail_boat_vessel.urdf for
     the general method (mesh/box match models/super_tanker_vessel/model.sdf;
     mass is a class-plausible estimate - ~9000 tonnes displacement for a
     ~90m product-tanker-sized vessel; inertia is the solid-box
     approximation from that mass and the collision box). -->
<robot name="super_tanker_vessel">
    <link name="base_link">
        <inertial>
            <origin xyz="0 0 -14" rpy="0 0 0"/>
            <mass value="9000000"/>
            <inertia ixx="735000000" ixy="0" ixz="0" iyy="6663000000" iyz="0" izz="6222000000"/>
        </inertial>
        <visual>
            <origin xyz="0 0 -14" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://hybraut_nav_colreg_sim/models/super_tanker_vessel/meshes/SuperTanker.obj" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 -14" rpy="0 0 0"/>
            <geometry>
                <box size="90 14 28"/>
            </geometry>
        </collision>
    </link>

    <gazebo reference="base_link">
        <gravity>false</gravity>
    </gazebo>

    <gazebo>
        <static>false</static>
        <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        </plugin>
        <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
            <!-- Prefixed with the model name - see hydrofoil.urdf's
                 OdometryPublisher block for why: plain odom/base_link here
                 would collide with every other vessel's frame_ids on the
                 shared /tf topic. -->
            <odom_frame>super_tanker_vessel/odom</odom_frame>
            <robot_base_frame>super_tanker_vessel/base_link</robot_base_frame>
            <odom_publish_frequency>50</odom_publish_frequency>
            <dimensions>3</dimensions>
        </plugin>
    </gazebo>
</robot>
