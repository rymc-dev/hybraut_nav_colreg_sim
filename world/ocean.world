<?xml version="1.0"?>
<sdf version="1.9">
  <world name="ocean_world">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>

    <scene>
      <sky></sky>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.7 0.9 1.0 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.3 0.3 -0.9</direction>
    </light>

    <!-- Animated FFT/Gerstner ocean surface from asv_wave_sim, resolved via
         model://ocean_waves on GZ_SIM_RESOURCE_PATH (see gz_sim.launch.py).
         Visual-only: the hull has gravity disabled and is velocity-controlled
         (see urdf/hydrofoil.urdf), so it never physically rested on the old
         flat plane's collision surface either. -->
    <!-- <include>
      <uri>model://ocean_waves</uri>
    </include> -->

    <!-- Static blue plate replacing the animated ocean surface above, for
         performance. Swap back to the include above to restore animated waves. -->
    <include>
      <uri>model://ocean_plate</uri>
    </include>

  </world>
</sdf>